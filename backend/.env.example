# Copy to backend/.env. The Snowflake values are only needed for tests and seeding,
# because users connect their own account in the UI.
APP_SECRET_KEY=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:3000

SNOWFLAKE_ACCOUNT=ORGNAME-ACCOUNTNAME
SNOWFLAKE_USER=YOUR_LOGIN_NAME
SNOWFLAKE_API=your-programmatic-access-token
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_DEFAULT_TABLE=DEMO_CORP.SALES.V_SALES

# Open-source LLM through any OpenAI-compatible endpoint
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=ollama
